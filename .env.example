POSTGRES_PASSWORD=replace-with-a-long-random-password
CAS_PORT=8080
CAS_BOOTSTRAP_APP_ID=example-app
CAS_BOOTSTRAP_APP_KEY=replace-with-a-long-random-application-key
USERGATE_BASE_URL=https://usergate.sandalgurun.web.id/api/v1
USERGATE_API_KEY=replace-with-usergate-api-key
CAS_MAX_UPLOAD_BYTES=52428800
CAS_TESTER_ORIGIN=null
# Untuk Tahap 1, gunakan profil storage dan sertifikat CA internal di ./certs/ca.crt.
CAS_STORAGE_NODE_URL=
# Untuk beberapa node, isi JSON list: [{"id":"storage-1","url":"https://host:8081","failure_domain":"host-a","token":"secret","ca_file":"/certs/ca.crt"}]
CAS_STORAGE_NODES=
CAS_STORAGE_NODE_CA_FILE=/certs/ca.crt
CAS_STORAGE_NODE_ID=storage-1
CAS_NODE_SERVICE_TOKEN=replace-with-a-long-random-node-token
CAS_NODE_MIN_FREE_BYTES=1048576
CAS_NODE_MAX_OBJECT_BYTES=10737418240
CAS_STREAM_TIMEOUT_SECONDS=900
